
NEXT_PUBLIC_APP_URL=https://voice.getaipilot.in
NEXT_PUBLIC_API_URL=https://api.getaipilot.in
PORT=8000

# ------------------------------------------------------------------------------
# Core Security & Credential Encryption Keys (Server-Only Secrets)
# ------------------------------------------------------------------------------
CONNECTOR_ENCRYPTION_KEY=voicepilot_connector_secret_32b_key_prod
VOICE_PILOT_SSO_SECRET=your_voicepilot_sso_secret_key_here

# ------------------------------------------------------------------------------
# Supabase Database & Auth (Server & Client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Voice Platform (Vomyra)
# ------------------------------------------------------------------------------
VOMYRA_API_KEY=your_vomyra_api_key_here
VOMYRA_BASE_URL=https://api.vomyra.com
VOMYRA_WEBHOOK_SECRET=your_vomyra_webhook_secret_here

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ------------------------------------------------------------------------------
# Infrastructure & AI Services
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# VoicePilot Platform OAuth Developer App Credentials (Server-Only)
# Customers do NOT enter these. VoicePilot owns one developer app per provider.
# ------------------------------------------------------------------------------

# 1. Gmail / Google OAuth App
# Obtained from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://api.getaipilot.in/api/v1/connectors/gmail/callback

# 2. Slack App
# Obtained from: Slack API Console (api.slack.com) -> Apps -> OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.getaipilot.in/api/v1/connectors/slack/callback

# 3. Salesforce Connected App
# Obtained from: Salesforce Setup -> App Manager -> New Connected App -> OAuth Settings
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/salesforce/callback
SALESFORCE_AUTH_URL=https://login.salesforce.com/services/oauth2/authorize
SALESFORCE_TOKEN_URL=https://login.salesforce.com/services/oauth2/token

# 4. Notion Integration App
# Obtained from: Notion Developers (developers.notion.com) -> Integrations -> Public Integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://api.getaipilot.in/api/v1/connectors/notion/callback
NOTION_AUTH_URL=https://api.notion.com/v1/oauth/authorize

# 5. Linear OAuth Application
# Obtained from: Linear Settings -> Account -> API -> OAuth Applications
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=https://api.getaipilot.in/api/v1/connectors/linear/callback

# 6. HubSpot MCP Auth App (OAuth 2.1 PKCE)
# Obtained from: HubSpot Developer Portal -> Apps -> Auth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://api.getaipilot.in/api/v1/connectors/hubspot/callback
HUBSPOT_AUTH_URL=https://app.hubspot.com/oauth/authorize
HUBSPOT_MCP_URL=https://mcp.hubspot.com
